# Supabase Configuration (Web only uses URL and Anon/Publishable Key)
# DO NOT place service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: comma-separated emails allowed to open /developer-diagnostics.
# Leave empty to hide the diagnostics menu for every user.
VITE_DEVELOPER_EMAILS=

